# Terraform
**/.terraform/
.terraform-plans/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Note: .terraform.lock.hcl is deliberately NOT ignored - it must be committed
# so provider versions are reproducible.

# Generated by scripts/configure.sh and specific to one account, region, and
# checkout. Keep the generated files as the single local source of these values.
config.env
backend.hcl
*.auto.tfvars
.env
.env.*
!.env.example

# Local
.DS_Store
.claude/settings.local.json
__pycache__/
*.pyc

# Re-include files that common global gitignores exclude.
!.terraform.lock.hcl
!docs/captures/**/*.log
!scripts/fixtures/**/*.log
